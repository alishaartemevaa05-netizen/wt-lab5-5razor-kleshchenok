@page
@model wt_lab5_5razor_kleshchenok.Pages.Rentals.CreateModel
@{
    ViewData["Title"] = "Оформление аренды";
}

<div class="container py-4">
    <div class="card shadow-sm rounded-4">
        <div class="card-body">
            <h2 class="mb-4">📝 Оформление аренды</h2>

            @if (!Model.AvailableCars.Any())
            {
                <div class="alert alert-warning">
                    Нет доступных автомобилей. Верните авто или добавьте новые.
                </div>
                <a asp-page="./Index" class="btn btn-secondary">← Назад к арендам</a>
            }
            else
            {
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Rental.CarId" class="form-label">Автомобиль</label>
                        <select asp-for="Rental.CarId" class="form-select"
                                asp-items="Model.AvailableCars">
                            <option value="">— выберите автомобиль —</option>
                        </select>
                        <span asp-validation-for="Rental.CarId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Rental.CustomerId" class="form-label">Клиент</label>
                        <select asp-for="Rental.CustomerId" class="form-select"
                                asp-items="Model.Customers">
                            <option value="">— выберите клиента —</option>
                        </select>
                        <span asp-validation-for="Rental.CustomerId" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Rental.StartDate" class="form-label"></label>
                            <input asp-for="Rental.StartDate" type="date" class="form-control" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Rental.EndDate" class="form-label"></label>
                            <input asp-for="Rental.EndDate" type="date" class="form-control" />
                            <span asp-validation-for="Rental.EndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">💾 Оформить</button>
                        <a asp-page="./Index" class="btn btn-secondary">← Назад</a>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}