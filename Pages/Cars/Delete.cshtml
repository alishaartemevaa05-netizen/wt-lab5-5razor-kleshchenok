@page
@model wt_lab5_5razor_kleshchenok.Pages.Cars.DeleteModel
@{
    ViewData["Title"] = "Удаление";
}

<div class="container py-4">
    <div class="card shadow-sm rounded-4">
        <div class="card-body">
            <h2 class="mb-3">🗑️ Удаление автомобиля</h2>
            <p>Вы уверены, что хотите удалить <strong>@Model.Car!.Brand @Model.Car.Model</strong>?</p>

            <form method="post">
                <input type="hidden" name="id" value="@Model.Car.Id" />
                <button type="submit" class="btn btn-danger">Да, удалить</button>
                <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
            </form>
        </div>
    </div>
</div>