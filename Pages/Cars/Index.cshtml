@page
@model wt_lab5_5razor_kleshchenok.Pages.Cars.IndexModel
@{
    ViewData["Title"] = "Автомобили";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="fw-bold mb-0">🚗 Каталог автомобилей</h1>
            <p class="text-muted mb-0">Найдено: @Model.Cars.Count</p>
        </div>
        <a asp-page="/Cars/Create" class="btn btn-primary">➕ Добавить автомобиль</a>
    </div>

    <form method="get" class="row g-2 mb-4">
        <div class="col-12 col-md-6">
            <input asp-for="Search" class="form-control" placeholder="Поиск по марке или модели" />
        </div>
        <div class="col-12 col-md-4">
            <select asp-for="Category" class="form-select"
                    asp-items="Html.GetEnumSelectList<wt_lab5_5razor_kleshchenok.Models.CarCategory>()">
                <option value="">Все категории</option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-grid">
            <button type="submit" class="btn btn-outline-primary">Найти</button>
        </div>
    </form>

    @if (Model.Cars.Count == 0)
    {
        <div class="alert alert-info">Автомобили не найдены.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var car in Model.Cars)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm rounded-4">
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge bg-secondary">ID: @car.Id</span>
                                @if (car.IsAvailable)
                                {
                                    <span class="badge bg-success">Доступен</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">В аренде</span>
                                }
                                <span class="badge bg-info text-dark">@car.Category.GetDisplayName()</span>
                            </div>
                            <h5 class="card-title">@car.Brand @car.Model</h5>
                            <p class="text-muted mb-1">Год: @car.Year | @car.Transmission.GetDisplayName()</p>
                            <p class="text-muted mb-2">@car.FuelType.GetDisplayName()</p>
                            <p class="fs-4 fw-bold mt-auto mb-2">@car.DailyPrice.ToString("0.##") руб./сутки</p>
                            <div>
                                <a asp-page="/Cars/Details" asp-route-id="@car.Id"
                                   class="btn btn-outline-primary btn-sm">Подробнее</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>